      <style:text-properties style:font-name="Liberation Sans" fo:font-size="12.5pt" fo:color="#3B34C7" fo:font-weight="bold" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="Sub" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0.35cm" fo:line-height="145%"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="10.5pt" fo:color="#5A5872" fo:font-weight="normal" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0.18cm" fo:line-height="145%"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="10.5pt" fo:color="#16152B" fo:font-weight="normal" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="Small" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0.2cm" fo:line-height="130%"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="8.5pt" fo:color="#5A5872" fo:font-weight="normal" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="Note" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0.5cm" fo:line-height="135%" fo:background-color="#F6F5FB" fo:border-left="0.12cm solid #3B34C7" fo:padding-left="0.35cm" fo:padding-top="0.15cm" fo:padding-bottom="0.15cm" fo:padding-right="0.3cm"/>

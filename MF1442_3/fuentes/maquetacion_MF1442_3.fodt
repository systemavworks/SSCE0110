      <text:h text:style-name="H2" text:outline-level="2">10 · Alineación constructiva</text:h>
      <table:table table:name="T10" table:style-name="Table1">
        <table:table-column table:style-name="co10_0"/>
        <table:table-column table:style-name="co10_1"/>
        <table:table-column table:style-name="co10_2"/>
        <table:table-column table:style-name="co10_3"/>
        <table:table-row>
          <table:table-cell table:style-name="CellHead" office:value-type="string">
            <text:p text:style-name="TableHeadP">Objetivo</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="CellHead" office:value-type="string">
            <text:p text:style-name="TableHeadP">Actividad</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="CellHead" office:value-type="string">

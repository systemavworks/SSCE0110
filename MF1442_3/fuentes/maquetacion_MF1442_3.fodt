          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">6</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">01/12/2026</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">3.5–3.7 · Contenidos; secuenciación; actividades</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">Tabla de contenidos y secuencia</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">7</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">02/12/2026</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">3.8–3.12 · Metodología; modalidades; recursos; evaluación y mejora</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">Rúbrica y criterios ponderados</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">8</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">03/12/2026</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">4.1–4.2 · Temporalización diaria; secuenciación de actividades</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">Cronograma y guion minuteado</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">9</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">04/12/2026</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">4.3 · Guía del alumno en línea, repaso y entrega</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">Guía del alumno y programación final</text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Small">Los días 7 y 8 de diciembre, 24 y 25 de diciembre, 31 de diciembre y 1, 5 y 6 de enero son no lectivos en el cronograma del centro, fuera ya de esta ventana.</text:p>

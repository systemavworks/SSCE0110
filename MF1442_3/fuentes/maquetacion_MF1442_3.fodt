          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">
              <text:span text:style-name="PhSpan">[CE2]</text:span>
            </text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">
              <text:span text:style-name="PhSpan">[OE3 · Diseñar la evaluación]</text:span>
            </text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">
              <text:span text:style-name="PhSpan">[Prueba práctica + rúbrica]</text:span>
            </text:p>

      </text:list-level-style-bullet>
    </text:list-style>
    <style:style style:name="Kicker" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0.35cm" fo:line-height="145%"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="8.5pt" fo:color="#00958C" fo:font-weight="bold" fo:font-style="normal"/>
    </style:style>

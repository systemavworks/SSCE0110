            <text:p text:style-name="TableCellP">2.1–2.2</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">2.1 certificado: características, vías, perfil y referente formativo, prescripciones y espacios · 2.2 programación vinculada a la certificación</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">S3 (2.1) · S4 (2.2)</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">U3</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">3.1–3.12</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">3.1 función y ventajas · 3.2 competencias · 3.3 características · 3.4 objetivos · 3.5 contenidos · 3.6 secuenciación · 3.7 actividades · 3.8 metodología (3.8.1 y 3.8.2) · 3.9 modalidades · 3.10 recursos · 3.11 evaluación · 3.12 mejora</text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">

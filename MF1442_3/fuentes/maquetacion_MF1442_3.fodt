              <text:span text:style-name="PhSpan">[Rúbrica aplicada]</text:span>
            </text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">
              <text:span text:style-name="PhSpan">[CE3]</text:span>
            </text:p>
          </table:table-cell>
        </table:table-row>
      </table:table>
      <text:h text:style-name="H2" text:outline-level="2">11 · Seguimiento y tutorización</text:h>
      <text:list text:style-name="LB">
        <text:list-item>
          <text:p text:style-name="Body">Canal: <text:span text:style-name="PhSpan">[aula, correo y aula virtual; horario de respuesta]</text:span>.</text:p>
        </text:list-item>
        <text:list-item>
          <text:p text:style-name="Body">Registro: <text:span text:style-name="PhSpan">[hoja de seguimiento con fecha, entrega, devolución y acuerdos]</text:span>.</text:p>
        </text:list-item>
        <text:list-item>
          <text:p text:style-name="Body">Alumnado con dificultades: <text:span text:style-name="PhSpan">[medida concreta y plazo]</text:span>.</text:p>
        </text:list-item>
        <text:list-item>
          <text:p text:style-name="Body">Evidencias: cada entrega se guarda en <text:span text:style-name="PhSpan">[carpeta del módulo]</text:span> con la nomenclatura acordada.</text:p>
        </text:list-item>
      </text:list>
      <text:h text:style-name="H2" text:outline-level="2">12 · Riesgos y plan B</text:h>
      <table:table table:name="T11" table:style-name="Table1">
        <table:table-column table:style-name="co11_0"/>
        <table:table-column table:style-name="co11_1"/>
        <table:table-column table:style-name="co11_2"/>
        <table:table-row>
          <table:table-cell table:style-name="CellHead" office:value-type="string">

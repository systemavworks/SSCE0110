          </table:table-cell>
          <table:table-cell table:style-name="CellHead" office:value-type="string">
            <text:p text:style-name="TableHeadP">Criterio</text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">
              <text:span text:style-name="PhSpan">[OG1 · Analizar el contexto]</text:span>
            </text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">
              <text:span text:style-name="PhSpan">[Estudio de caso + debate guiado]</text:span>
            </text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">
              <text:span text:style-name="PhSpan">[Ficha del grupo]</text:span>
            </text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">
              <text:span text:style-name="PhSpan">[CE1]</text:span>
            </text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string">

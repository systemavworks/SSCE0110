            </text:p>
          </table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">
              <text:span text:style-name="PhSpan">[Grupo muy heterogéneo]</text:span>
            </text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">
              <text:span text:style-name="PhSpan">[Itinerario B y apoyo entre iguales]</text:span>
            </text:p>
          </table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string">
            <text:p text:style-name="TableCellP">

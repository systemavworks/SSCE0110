    <style:style style:name="AccentSpan" style:family="text">
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="11pt" fo:color="#3B34C7" fo:font-weight="bold" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="TealSpan" style:family="text">
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="11pt" fo:color="#00958C" fo:font-weight="bold" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="WhiteSpan" style:family="text">
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="12pt" fo:color="#FFFFFF" fo:font-weight="bold" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="BigWhite" style:family="text">

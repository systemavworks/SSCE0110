      <style:text-properties style:font-name="Liberation Sans" fo:font-size="9.5pt" fo:color="#16152B" fo:font-weight="normal" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="CellTextB" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="110%"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="9.5pt" fo:color="#16152B" fo:font-weight="bold" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="CellHeadText" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="8.5pt" fo:color="#FFFFFF" fo:font-weight="bold" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="CellSm" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="105%"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="8.5pt" fo:color="#16152B" fo:font-weight="normal" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="CellSmHead" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="8pt" fo:color="#FFFFFF" fo:font-weight="bold" fo:font-style="normal"/>

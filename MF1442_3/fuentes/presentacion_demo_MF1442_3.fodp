    </style:style>
    <style:style style:name="CellBgAlt" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#F6F5FB" draw:stroke="solid" draw:stroke-color="#E3E1F0" draw:shadow="none" draw:stroke-width="0.03cm"/>
    </style:style>
    <style:style style:name="CellBgHead" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#16152B" draw:stroke="solid" draw:stroke-color="#16152B" draw:shadow="none" draw:stroke-width="0.03cm"/>
    </style:style>
    <style:style style:name="PillIndigo" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#3B34C7" draw:stroke="none" draw:stroke-color="#000000" draw:shadow="none"/>
    </style:style>
    <style:style style:name="PillTeal" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#00958C" draw:stroke="none" draw:stroke-color="#000000" draw:shadow="none"/>
    </style:style>
    <style:style style:name="PillMagenta" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#D6218C" draw:stroke="none" draw:stroke-color="#000000" draw:shadow="none"/>
    </style:style>
    <style:style style:name="PillAmber" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#F2A20C" draw:stroke="none" draw:stroke-color="#000000" draw:shadow="none"/>
    </style:style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="pm1">
      <style:page-layout-properties fo:page-width="33.867cm" fo:page-height="19.05cm" style:print-orientation="landscape" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm"/>
      <style:drawing-page-properties draw:fill="solid" draw:fill-color="#FFFFFF"/>
    </style:page-layout>
    <text:list-style style:name="LB">
      <text:list-level-style-bullet text:level="1" text:bullet-char="•">
        <style:list-level-properties text:space-before="0.55cm" text:min-label-width="0.5cm" fo:text-align="left"/>
        <style:text-properties fo:font-size="13pt" fo:color="#3B34C7"/>
      </text:list-level-style-bullet>
      <text:list-level-style-bullet text:level="2" text:bullet-char="–">
        <style:list-level-properties text:space-before="1.1cm" text:min-label-width="0.5cm" fo:text-align="left"/>
        <style:text-properties fo:font-size="12pt" fo:color="#3B34C7"/>
      </text:list-level-style-bullet>
    </text:list-style>
    <style:style style:name="Kicker" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0.2cm" fo:line-height="120%"/>

      <style:graphic-properties draw:fill="solid" draw:fill-color="#FBFAFF" draw:stroke="none" draw:stroke-color="#000000" draw:shadow="none"/>
    </style:style>
    <style:style style:name="CardBg" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#F6F5FB" draw:stroke="solid" draw:stroke-color="#E3E1F0" draw:shadow="none" draw:stroke-width="0.03cm"/>
    </style:style>
    <style:style style:name="CardW" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#FFFFFF" draw:stroke="solid" draw:stroke-color="#E3E1F0" draw:shadow="none" draw:stroke-width="0.03cm"/>
    </style:style>
    <style:style style:name="CellBgW" style:family="graphic">

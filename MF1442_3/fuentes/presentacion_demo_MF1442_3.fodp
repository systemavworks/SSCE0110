    </style:style>
    <style:style style:name="Accent" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#3B34C7" draw:stroke="none" draw:stroke-color="#000000" draw:shadow="none"/>
    </style:style>
    <style:style style:name="Accent2" style:family="graphic">

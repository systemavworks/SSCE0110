    </style:style>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="pm1"/>
  </office:master-styles>
  <office:body>
    <office:presentation>
      <draw:page draw:name="Portada" draw:master-page-name="Default">
        <draw:rect draw:style-name="Dark" draw:name="r" svg:x="0cm" svg:y="0cm" svg:width="33.867cm" svg:height="19.05cm"/>
        <draw:rect draw:style-name="Accent" draw:name="r" svg:x="0cm" svg:y="0cm" svg:width="0.55cm" svg:height="19.05cm"/>
        <draw:rect draw:style-name="Accent2" draw:name="r" svg:x="0.55cm" svg:y="0cm" svg:width="0.18cm" svg:height="19.05cm"/>
        <draw:rect draw:style-name="PillMagenta" draw:name="r" svg:x="25.8cm" svg:y="1.75cm" svg:width="5.9cm" svg:height="1.15cm"/>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="26.15cm" svg:y="1.97cm" svg:width="5.2cm" svg:height="0.8cm">
          <draw:text-box>
            <text:p text:style-name="PillText">PLANTILLA DEMO</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="2.3cm" svg:y="3.2cm" svg:width="22.0cm" svg:height="0.9cm">
          <draw:text-box>
            <text:p text:style-name="Kicker">SSCE0110 · MÓDULO FORMATIVO · NIVEL 3</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="2.3cm" svg:y="3.85cm" svg:width="23.6cm" svg:height="6.2cm">
          <draw:text-box>
            <text:p text:style-name="TitleBig">Programación didáctica de acciones formativas para el empleo</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="2.3cm" svg:y="10.5cm" svg:width="26.0cm" svg:height="1.8cm">
          <draw:text-box>
            <text:p text:style-name="SubLight">MF1442_3 · 60 horas · 9 sesiones · Unidad de competencia UC1442_3</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="2.3cm" svg:y="15.4cm" svg:width="27.0cm" svg:height="0.9cm">
          <draw:text-box>
            <text:p text:style-name="SubLight">CEFI Formación (Almonte) · 24/11/2026 → 04/12/2026</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="2.3cm" svg:y="16.3cm" svg:width="27.0cm" svg:height="0.9cm">
          <draw:text-box>
            <text:p text:style-name="Small">Sustituye los textos entre [corchetes]. Una idea por diapositiva.</text:p>
          </draw:text-box>
        </draw:frame>
      </draw:page>
      <draw:page draw:name="Como usar" draw:master-page-name="Default">
        <draw:rect draw:style-name="Accent" draw:name="r" svg:x="0cm" svg:y="0cm" svg:width="0.45cm" svg:height="19.05cm"/>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="2.0cm" svg:y="1.7cm" svg:width="29.0cm" svg:height="0.9cm">
          <draw:text-box>
            <text:p text:style-name="Kicker">00 · ANTES DE EMPEZAR</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="2.0cm" svg:y="2.3cm" svg:width="29.6cm" svg:height="2.9cm">
          <draw:text-box>
            <text:p text:style-name="Title">Cómo usar esta plantilla</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="2.0cm" svg:y="4.9cm" svg:width="28.0cm" svg:height="1.0cm">
          <draw:text-box>
            <text:p text:style-name="Subtitle">Cuatro pasos y la presentación queda lista para la defensa del módulo.</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:rect draw:style-name="CardW" draw:name="r" svg:x="2.0cm" svg:y="6.2cm" svg:width="14.3cm" svg:height="4.5cm"/>
        <draw:rect draw:style-name="PillIndigo" draw:name="r" svg:x="2.0cm" svg:y="6.2cm" svg:width="0.14cm" svg:height="4.5cm"/>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="2.45cm" svg:y="6.5cm" svg:width="13.4cm" svg:height="0.8cm">
          <draw:text-box>
            <text:p text:style-name="CardTitle">1 · Duplica el archivo</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="2.45cm" svg:y="7.35cm" svg:width="13.350000000000001cm" svg:height="3.15cm">
          <draw:text-box>
            <text:p text:style-name="CardBody">Guarda una copia como <text:span text:style-name="AccentSpan">MF1442_3_presentacion_[tunombre].pptx</text:span>. También puedes subirlo a Google Slides (Archivo → Abrir → Subir) o a Canva (Importar archivo).</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:rect draw:style-name="CardW" draw:name="r" svg:x="17.5cm" svg:y="6.2cm" svg:width="14.3cm" svg:height="4.5cm"/>
        <draw:rect draw:style-name="PillTeal" draw:name="r" svg:x="17.5cm" svg:y="6.2cm" svg:width="0.14cm" svg:height="4.5cm"/>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="17.95cm" svg:y="6.5cm" svg:width="13.4cm" svg:height="0.8cm">
          <draw:text-box>
            <text:p text:style-name="CardTitle">2 · Rellena los corchetes</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="17.95cm" svg:y="7.35cm" svg:width="13.350000000000001cm" svg:height="3.15cm">
          <draw:text-box>
            <text:p text:style-name="CardBody">Todo lo que aparece entre [corchetes] es un hueco: datos del grupo, objetivos, contenidos, criterios y evidencias. Borra el corchete cuando lo escribas.</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:rect draw:style-name="CardW" draw:name="r" svg:x="2.0cm" svg:y="11.1cm" svg:width="14.3cm" svg:height="4.5cm"/>
        <draw:rect draw:style-name="PillMagenta" draw:name="r" svg:x="2.0cm" svg:y="11.1cm" svg:width="0.14cm" svg:height="4.5cm"/>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="2.45cm" svg:y="11.4cm" svg:width="13.4cm" svg:height="0.8cm">
          <draw:text-box>
            <text:p text:style-name="CardTitle">3 · Una idea por diapositiva</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="2.45cm" svg:y="12.25cm" svg:width="13.350000000000001cm" svg:height="3.15cm">
          <draw:text-box>
            <text:p text:style-name="CardBody">Máximo 6 líneas y 2 niveles de lista. Si necesitas más, duplica la diapositiva: la plantilla está hecha para crecer.</text:p>
          </draw:text-box>
        </draw:frame>
        <draw:rect draw:style-name="CardW" draw:name="r" svg:x="17.5cm" svg:y="11.1cm" svg:width="14.3cm" svg:height="4.5cm"/>
        <draw:rect draw:style-name="PillAmber" draw:name="r" svg:x="17.5cm" svg:y="11.1cm" svg:width="0.14cm" svg:height="4.5cm"/>
        <draw:frame draw:style-name="frTop" draw:name="tb" svg:x="17.95cm" svg:y="11.4cm" svg:width="13.4cm" svg:height="0.8cm">
          <draw:text-box>
            <text:p text:style-name="CardTitle">4 · Exporta en dos formatos</text:p>
          </draw:text-box>
        </draw:frame>

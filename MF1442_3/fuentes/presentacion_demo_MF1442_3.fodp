      <style:text-properties style:font-name="Liberation Sans" fo:font-size="12pt" fo:color="#16152B" fo:font-weight="bold" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="CardBody" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0.1cm" fo:line-height="125%"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="10.5pt" fo:color="#5A5872" fo:font-weight="normal" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="BigNum" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="26pt" fo:color="#3B34C7" fo:font-weight="bold" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="BigNumS" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
      <style:text-properties style:font-name="Liberation Sans" fo:font-size="23pt" fo:color="#3B34C7" fo:font-weight="bold" fo:font-style="normal"/>
    </style:style>
    <style:style style:name="KpiLabel" style:family="paragraph">
      <style:paragraph-properties fo:text-align="start" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:line-height="120%"/>
